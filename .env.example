# Copy to `.env` and fill in. src/config/env.ts validates this at startup and THROWS on a
# missing required variable, so the app crash-loops rather than running with a bad config.

# --- Required ---------------------------------------------------------------------
# Local dev against `docker compose up -d db`:
DATABASE_URL="postgresql://billanta:billanta@localhost:5432/billanta?schema=public"
# On EC2 the app reaches the HOST's Postgres through the docker gateway:
# DATABASE_URL="postgresql://billanta:<password>@host.docker.internal:5432/billanta?schema=public"

# Signs the short-lived access token. Generate: openssl rand -hex 32
JWT_SECRET="change-me"

# The Google OAuth *Web* client id. Every idToken is verified server-side and its `aud`
# claim must equal this — an idToken minted for another client is rejected.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"

# Bearer key for the /admin authoring API. Operator-only, never shipped to clients.
# Generate: openssl rand -hex 32
ADMIN_API_KEY="change-me"

# --- Optional ---------------------------------------------------------------------
PORT=3000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# Media storage (logos, signatures, QR images, template thumbnails). If S3_BUCKET or
# AWS_REGION is unset, POST /media returns 503 and the rest of the app works normally.
# Credentials come from the AWS default provider chain — on EC2 that's the instance's
# IAM role, so NO access keys belong in this file.
# S3_BUCKET=billanta-media
# AWS_REGION=ap-south-1
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Admin panel login (GET /admin). Checked server-side by POST /admin/login, which then
# returns ADMIN_API_KEY to the browser session. Unset => panel login disabled.
# ADMIN_PANEL_USER=admin
# ADMIN_PANEL_PASSWORD=change-me

# Host port for docker-compose.prod.yml (published on 127.0.0.1 only).
# APP_HOST_PORT=8091
