{
  "name": "billanta-backend",
  "version": "1.0.0",
  "description": "Backend for Billanta — a mobile-first invoice generator for Android",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --files src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "check:auth": "ts-node src/scripts/checkAuthRotation.ts",
    "check:phase3": "ts-node src/scripts/checkPhase3Isolation.ts",
    "check:phase3v": "ts-node src/scripts/checkPhase3Validation.ts",
    "check:compiler": "ts-node src/scripts/checkCompiler.ts",
    "check:seeds": "ts-node src/scripts/checkSeedTemplates.ts",
    "seed:templates": "ts-node src/scripts/seedTemplates.ts",
    "check:phase4": "ts-node src/scripts/checkPhase4Pipeline.ts",
    "check:money": "ts-node src/scripts/checkMoney.ts",
    "check:phase5": "ts-node src/scripts/checkPhase5Pipeline.ts",
    "test": "echo \"No test framework — use `npm run typecheck` plus the scripts in scripts/\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "parse5": "^8.0.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
